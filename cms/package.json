{
  "name": "cms",
  "version": "1.0.0",
  "description": "DEGSON 新官网后台（Directus 11，版本锁定）",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "directus start",
    "bootstrap": "directus bootstrap",
    "snapshot": "directus schema snapshot --yes ./snapshot.yaml",
    "apply": "directus schema apply --yes ./snapshot.yaml"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=20 <23"
  },
  "dependencies": {
    "directus": "11.17.4"
  }
}
