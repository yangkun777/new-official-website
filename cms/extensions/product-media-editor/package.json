{
	"name": "product-media-editor",
	"description": "Please enter a description for your extension",
	"license": "MIT",
	"icon": "extension",
	"version": "1.0.0",
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-bundle"
	],
	"type": "module",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "bundle",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"entries": [
			{
				"type": "interface",
				"name": "product-media-editor",
				"source": "src/interface.js"
			},
			{
				"type": "display",
				"name": "product-media-thumbnail",
				"source": "src/display.js"
			}
		],
		"host": "^11.0.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"validate": "directus-extension validate"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "17.1.4",
		"vue": "^3.5.43"
	},
	"dependencies": {
		"xlsx": "^0.18.5"
	}
}
